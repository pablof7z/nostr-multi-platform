# EditorConfig — https://editorconfig.org
#
# Scoped narrowly to one concern: the checked-in `flatc --swift` bindings under
# apps/chirp/ios/Chirp/Bridge/Generated/ are byte-for-byte the raw `flatc 25.12.19`
# output and are guarded by `ci/check-swift-flatc-drift.sh` as a PURE byte-diff
# (no fuzzing, consistent with the Rust/Kotlin/TS flatc drift gates). flatc
# emits a trailing space after the file-identifier accessor
# (`public static var id: String { "NFTS" } `). An editor that trims trailing
# whitespace on save silently re-drifts those files away from raw flatc output
# and turns the gate permanently red. Exempt the generated tree from
# trailing-whitespace trimming so the committed bytes stay equal to flatc's.
#
# Do NOT widen `root = true` or add unrelated rules here — the repo has no
# project-wide EditorConfig and adding one would be a behavior change outside
# the scope of the flatc-drift gate (AGENTS.md: single source of truth).
root = true

[apps/chirp/ios/Chirp/Bridge/Generated/**.generated.swift]
trim_trailing_whitespace = false
insert_final_newline = false
