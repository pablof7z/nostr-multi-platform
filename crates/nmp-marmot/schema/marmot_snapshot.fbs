namespace nmp.marmot;

// Typed FlatBuffers wire for the `nmp.marmot.snapshot` push projection
// (`crate::projection::payload::MarmotSnapshot`, the shape
// `MarmotProjection::snapshot(now)` serialises).
//
// This is the typed sidecar (ADR-0037) carried ALONGSIDE the existing generic
// `serde_json::Value` projection registered under the same key by a host-owned
// projection producer. The serde shape stays authoritative; this buffer mirrors
// it field-for-field so a host with an `NMMS` decoder can read typed accessors
// instead of JSON reflection. An un-updated host falls back to the generic
// `Value` subtree (the permanent fallback from ADR-0037).
//
// Raw data only (aim.md §2): hex group ids / pubkeys, Unix-second timestamps,
// raw counts. Presentation layers (Swift, Kotlin, TUI, web) own all fallback
// copy, initials computation, pluralisation, and formatted labels.
//
// Optional fields use the `has_x` presence-flag + value convention (the same
// one used by content_tree.fbs / wallet_status.fbs / wot_bootstrap.fbs) so
// `None` round-trips distinctly from a present-empty string / zero value:
//   * MarmotGroupRow.unread_count: Option<u32>      -> has_unread_count + value
//   * MarmotGroupRow.last_msg_at:  Option<u64>      -> has_last_msg_at  + value
//   * KeyPackageStatus.d_tag:      Option<String>   -> has_d_tag        + value
//   * KeyPackageStatus.age_secs:   Option<u64>      -> has_age_secs     + value
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// is self-contained (no `include`), so generate with plain `flatc --rust`:
//
//   flatc --rust -o crates/nmp-marmot/src/wire/generated \
//         crates/nmp-marmot/schema/marmot_snapshot.fbs

// One group row. Mirrors `crate::projection::payload::MarmotGroupRow`.
table MarmotGroupRow {
  id_hex:string;            // MLS group id, hex
  name:string;              // group name, verbatim MLS metadata (may be empty)
  members:[string];         // member Nostr pubkeys (hex, 64 chars), sorted
  member_count:uint32;      // members.len()
  has_unread_count:bool;    // Option<u32> presence
  unread_count:uint32;      // total decrypted app-message count (no read cursor)
  has_last_msg_at:bool;     // Option<u64> presence
  last_msg_at:uint64;       // most-recent message created_at, Unix seconds
}

// One pending (un-accepted) Welcome. Mirrors
// `crate::projection::payload::PendingWelcomeRow`.
table PendingWelcomeRow {
  id_hex:string;            // kind:444 Welcome event id, hex
  group_name:string;        // group name verbatim from the Welcome (may be empty)
  inviter_npub:string;      // inviter Nostr pubkey (hex, 64 chars — name is historical)
}

// KeyPackage publication health. Mirrors
// `crate::projection::payload::KeyPackageStatus`. Raw data only (aim.md §2):
// shells derive subtitle copy and button labels from these fields.
table KeyPackageStatus {
  published:bool;
  has_d_tag:bool;           // Option<String> presence
  d_tag:string;             // kind:30443 `d` tag of the most recent publication
  has_age_secs:bool;        // Option<u64> presence
  age_secs:uint64;          // seconds since most recent publication
  stale:bool;               // age_secs exceeds the 7-day rotation threshold
  is_registered:bool;       // built against a registered signing identity
}

/// One parked (deferred) op waiting for a peer's KP to arrive.
/// Mirrors `crate::projection::payload::PendingOpRow`.
/// Shells format display copy from op_tag + missing_count (aim.md §2).
table PendingOpRow {
  correlation_id:string;    // original action correlation_id
  op_tag:string;            // "create_group" | "invite"
  missing_count:uint32;     // remaining missing KP count
  age_secs:uint64;          // wall-clock seconds since the op was parked (now - created_at)
}

/// The most recent terminal op FAILURE (deferred-op expiry or a failed
/// retry). Mirrors `crate::projection::payload::LastOpError`. Raw data only
/// (aim.md §2): `reason` is the machine code, native maps it to a banner.
table LastOpError {
  op:string;                // failing op tag ("create_group" | "invite")
  reason:string;            // machine code, e.g. "key_package_unavailable"
  at_secs:uint64;           // wall-clock second the failure was recorded
  correlation_id:string;    // correlation_id of the failed action
}

// The complete snapshot. Mirrors `crate::projection::payload::MarmotSnapshot`.
table MarmotSnapshot {
  schema_version:uint32 = 2;       // mirrors SCHEMA_VERSION; bumped on every ABI change
  groups:[MarmotGroupRow];
  pending_welcomes:[PendingWelcomeRow];
  key_package:KeyPackageStatus;
  cached_kp_pubkeys:[string];      // peer pubkeys (hex) with a cached KeyPackage
  is_registered:bool;              // built against a registered signing identity
  orphaned_commit_count:uint32;    // V-61 dropped-handle diagnostic
  // #1651 service-init failure (replaces the V-62 `keyring_unavailable` bool).
  // Raw token: ""=none, "keyring_unavailable", "db_key_lost". Shells map to copy.
  init_error_kind:string;          // machine token, empty = no init error
  init_error_detail:string;        // raw detail (DbKeyLost only), empty otherwise
  pending_ops:[PendingOpRow];      // ops parked waiting for peer KPs (deferred completion)
  last_op_error:LastOpError;       // most recent terminal op failure (absent table = none)
}

root_type MarmotSnapshot;
file_identifier "NMMS";
