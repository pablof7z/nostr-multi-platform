namespace nmp.kernel;

// Typed FlatBuffers wire for the actor-owned `bunker_connection_state` snapshot
// projection (Tier-1 closure path — registered via `SnapshotRegistry::register`
// AND `SnapshotRegistry::register_typed` in `crates/nmp-core/src/actor/mod.rs`).
//
// The producer is the `registry.register("bunker_connection_state", …)` closure
// in `crates/nmp-core/src/actor/mod.rs`, which serialises the shared
// `BunkerConnectionStateSlot` (`Arc<Mutex<Option<BunkerConnectionStateDto>>>`).
// When the slot holds `None` (no bunker session active) the closure contributes
// JSON `null`; when it holds `Some(dto)` it serialises the
// `BunkerConnectionStateDto`. That generic `Value` projection stays the source of
// truth (registered unchanged); this buffer is emitted ALONGSIDE it in the
// `SnapshotFrame`'s `typed_projections` sidecar (ADR-0037) under the SAME key,
// and ONLY when the JSON closure produces a non-null value (the typed closure
// returns `None` while the slot is `None`, so no sidecar entry is emitted while
// idle). A host with a `KBCS` decoder prefers this typed payload; an un-updated
// host falls back to the generic `Value` subtree. Purely additive (V-14 step b,
// closes #963).
//
// Field-for-field mirror of the serialised `BunkerConnectionStateDto`
// (`crates/nmp-core/src/actor/commands/identity.rs`). All fields are present in
// every serialisation. `reason` is the only `Option<String>` and uses
// `has_reason` as the companion-bool (the #1029 `ProfileCard` convention).
//
// D0: relay-layer connection state for a remote signer session is an app noun;
// NOT a typed `KernelSnapshot` field — projected under
// `projections["bunker_connection_state"]` exactly like a host-registered
// namespace, and typed here ALONGSIDE the generic `Value`. D6: the decoder
// returns `Err(String)` on malformed input, never panics.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh:
//   flatc --rust -o crates/nmp-core/src/actor/typed_projections/generated \
//         crates/nmp-core/schema/bunker_connection_state.fbs
//
// Regenerate the checked-in Swift bindings only with the same pin:
//   flatc --swift -o ios/Chirp/Chirp/Bridge/Generated \
//         crates/nmp-core/schema/bunker_connection_state.fbs

table BunkerConnectionState {
  // Wire state token: "connected" | "reconnecting" | "failed".
  // Carried verbatim from `BunkerConnectionStateDto::state`.
  state:string;
  // Optional human-readable error reason (present on reconnecting/failed).
  // `has_reason == false` mirrors JSON `null` (absent when connected).
  has_reason:bool;
  reason:string;
  // `state == "connected"`.
  is_connected:bool;
  // `state == "reconnecting"` — transient flap, auto-reconnect in progress.
  // Hosts show a reconnecting indicator on this signal.
  is_reconnecting:bool;
  // `state == "failed"` — permanent error, session bricked.
  // Hosts prompt re-auth on this signal.
  is_failed:bool;
}

file_identifier "KBCS";
root_type BunkerConnectionState;
