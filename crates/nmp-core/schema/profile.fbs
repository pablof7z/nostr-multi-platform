namespace nmp.kernel;

// Typed FlatBuffers wire for the kernel-owned `profile` snapshot projection
// (Tier-2: kernel built-in).
//
// The producer is `Kernel::snapshot_projections_with_publish_cluster` in
// `crates/nmp-core/src/kernel/update/projections.rs`, which inserts the
// `serde_json` serialisation of `profile_card()` (a `ProfileCard` for the
// active account) under the JSON key `"profile"`. That generic `Value`
// projection stays the source of truth (inserted unchanged); this buffer is
// emitted ALONGSIDE it in the `SnapshotFrame`'s `typed_projections` sidecar
// (ADR-0037) under the SAME key. A host with a `KPRF` decoder prefers this
// typed payload; an un-updated host falls back to the generic `Value` subtree.
// Purely additive (Wave C).
//
// Field-for-field mirror of `ProfileCard`. `ProfileCard` carries NO serde
// `skip_serializing_if`, so its three `Option<String>` fields serialise as
// JSON `null`-when-`None` (key always present); the typed buffer carries each
// presence as an explicit `has_*` flag. The `ProfileCard` table here is
// re-used verbatim by `author_view.fbs` (its own generated module — duplicate
// table names across separate `#[path]` modules do not collide).
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh:
//   flatc --rust -o crates/nmp-core/src/kernel/typed_projections/generated \
//         crates/nmp-core/schema/profile.fbs

table ProfileCard {
  // Hex pubkey.
  pubkey:string;
  // Bech32 `npub1…` encoding.
  npub:string;
  // Display name from kind:0; `has_display_name == false` mirrors JSON `null`.
  has_display_name:bool;
  display_name:string;
  // Picture URL from kind:0; `has_picture_url == false` mirrors JSON `null`.
  has_picture_url:bool;
  picture_url:string;
  // NIP-05 identifier (always present, empty when unknown).
  nip05:string;
  // About text (always present, empty/placeholder when no kind:0).
  about:string;
  // True when a kind:0 metadata event has been received for this pubkey.
  has_profile:bool;
  // Pre-extracted lightning address (lud16) / LNURL (lud06);
  // `has_lnurl == false` mirrors JSON `null`.
  has_lnurl:bool;
  lnurl:string;
}

table ProfileSnapshot {
  card:ProfileCard;
}

file_identifier "KPRF";
root_type ProfileSnapshot;
