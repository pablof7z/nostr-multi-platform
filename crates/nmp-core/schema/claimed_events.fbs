namespace nmp.kernel;

// Typed FlatBuffers wire for a single `refs.event` row payload.
//
// `claimed_events` used to be a whole-map Tier-2 built-in projection. ADR-0070
// Lane H deleted that host-visible projection. KCEV remains only as the
// namespace-specific payload codec inside a `refs.event` NRRD row: each row's
// payload is a `ClaimedEventsSnapshot` with exactly one
// `primary_id -> ClaimedEvent` entry. Hosts merge the outer NRRD batch through
// `RefRowCache` / `RefEventStore`, then decode this inner payload for the row.
//
// FlatBuffers has no map type, so the row still uses a vector of `{key, value}`
// entries. For refs.event that vector MUST contain one entry whose key matches
// both the outer NRRD row key and `value.primary_id`; host stores reject
// malformed/mismatched rows before commit.
//
// Field-for-field mirror of the event row payload. The raw `tags`
// field is a `Vec<Vec<String>>` (an array of tag rows, each a list of strings)
// — FlatBuffers has no nested-vector type, so it is modelled as `[TagRow]`
// where each `TagRow` wraps one inner `[string]`.
//
// D0: a claimed-events map carries raw protocol event data (kind / tags /
// content) but `kind` rides as an opaque `uint` and no kind-dependent branching
// happens in the buffer — it is a generic content-resolution view, not a
// protocol-specific projection, so it is kernel-owned and typed here. A
// refs.event `event.raw` row additionally carries canonical signed NIP-01 event
// JSON serialized from the store-owned RawEvent; per-protocol projections must
// not invent `raw_json` fields. D6: the decoder returns `Err(String)` on
// malformed input, never panics.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh:
//   flatc --rust -o crates/nmp-core/src/kernel/typed_projections/generated \
//         crates/nmp-core/schema/claimed_events.fbs

// One raw event tag — a wrapper for one inner `[string]` of a
// `Vec<Vec<String>>`. (FlatBuffers cannot nest vectors directly.)
table TagRow {
  values:[string];
}

// Field-for-field mirror of one refs.event row.
table ClaimedEvent {
  // The row key — hex-64 event id (nevent/note) or `kind:pubkey:d_tag`
  // (naddr). Carried in the body too (matches the outer NRRD row key).
  primary_id:string;
  // Canonical 64-hex event id of the resolved event.
  id:string;
  // Author pubkey, hex (64 chars).
  author_pubkey:string;
  // Event kind (opaque passthrough — no kind-dependent branching in the buffer).
  kind:uint;
  // Unix-seconds `created_at`.
  created_at:ulong;
  // Raw event tags (an array of tag rows, each a list of strings).
  tags:[TagRow];
  // Raw event content.
  content:string;
  // Serialized NFCT ContentTreeWire (KCTW buffer) of the parsed content, when
  // the kernel's content-parser seam is installed (web hosts). Empty/absent on
  // native (which parses via nmp-content directly) — fall back to `content`.
  content_tree_bytes:[ubyte];
  // Canonical signed NIP-01 event JSON, including `sig`. Present only for the
  // generic refs.event `event.raw` row shape; `event.embed` omits it.
  has_signed_event_json:bool;
  signed_event_json:string;
}

// One `primary_id -> ClaimedEvent` row entry.
table ClaimedEventEntry {
  // The map key — the event's `primary_id` (matches `value.primary_id`).
  key:string;
  value:ClaimedEvent;
}

table ClaimedEventsSnapshot {
  entries:[ClaimedEventEntry];
}

file_identifier "KCEV";
root_type ClaimedEventsSnapshot;
