namespace nmp.kernel;

// Typed FlatBuffers wire for the kernel-owned `author_view` snapshot projection
// (Tier-2: kernel built-in).
//
// The producer is `Kernel::snapshot_projections_with_publish_cluster` in
// `crates/nmp-core/src/kernel/update/projections.rs`, which inserts the
// `serde_json` serialisation of `author_view()` (an `AuthorViewPayload`) under
// the JSON key `"author_view"` — but ONLY when an author view is open (D5: the
// key is OMITTED entirely otherwise; never inserted as `null`). That generic
// `Value` projection stays the source of truth (inserted unchanged); this
// buffer is emitted ALONGSIDE it in the `SnapshotFrame`'s `typed_projections`
// sidecar (ADR-0037) under the SAME key, and is likewise emitted ONLY when the
// view is open (the typed entry is conditionally pushed; never an empty
// placeholder). A host with a `KAVW` decoder prefers this typed payload; an
// un-updated host falls back to the generic `Value` subtree. Purely additive
// (Wave C).
//
// Field-for-field mirror of `AuthorViewPayload`. The nested `ProfileCard` and
// `TimelineItem` tables mirror the same Rust DTOs (see `profile.fbs` /
// `thread_view.fbs`); each codec's `#[path]` generated module is independent,
// so duplicate table names across the view schemas do not collide.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh:
//   flatc --rust -o crates/nmp-core/src/kernel/typed_projections/generated \
//         crates/nmp-core/schema/author_view.fbs

table ProfileCard {
  pubkey:string;
  npub:string;
  has_display_name:bool;
  display_name:string;
  has_picture_url:bool;
  picture_url:string;
  nip05:string;
  about:string;
  has_profile:bool;
  has_lnurl:bool;
  lnurl:string;
}

table TimelineItem {
  id:string;
  author_pubkey:string;
  has_author_picture_url:bool;
  author_picture_url:string;
  has_author_lnurl:bool;
  author_lnurl:string;
  has_author_display_name:bool;
  author_display_name:string;
  kind:uint;
  content:string;
  content_preview:string;
  created_at:ulong;
  relay_count:uint;
  is_repost:bool;
  nav_target_id:string;
  repost_inner_content:string;
}

// Mirror of `ProfileDispatchSpec`. Present only when the action is a write.
table ProfileDispatchSpec {
  namespace:string;
  body_json:string;
}

// Mirror of `ProfileAction`. `author_view`'s `primary_action` is `Option`;
// `has_primary_action == false` mirrors the JSON `null` (the field always
// serialises — no serde skip — so the key is present with `null`).
table ProfileAction {
  kind:string;
  label:string;
  target_pubkey:string;
  icon_name:string;
  // `has_dispatch == false` mirrors the JSON `dispatch: null` (write vs. local
  // intent); when true, `dispatch` carries the namespace + body.
  has_dispatch:bool;
  dispatch:ProfileDispatchSpec;
}

table AuthorViewSnapshot {
  pubkey:string;
  state:string;
  profile:ProfileCard;
  items:[TimelineItem];
  note_count:ulong;
  note_count_display:string;
  has_primary_action:bool;
  primary_action:ProfileAction;
}

file_identifier "KAVW";
root_type AuthorViewSnapshot;
