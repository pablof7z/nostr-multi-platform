namespace nmp.kernel;

// SHARED `TimelineItem` row type for the kernel-owned view snapshot projections
// (`author_view`, `thread_view`).
//
// Before this file existed, `author_view.fbs` and `thread_view.fbs` each
// re-declared `TimelineItem` verbatim. That duplication was harmless for
// `flatc --rust` (each `*_generated.rs` lives in its own `#[path]` module, so
// the duplicate Rust `TimelineItem` types do not collide — the #1029 convention)
// but FATAL for `flatc --swift`: every `.generated.swift` lands in ONE flat
// Swift module, so two files each declaring
// `public struct nmp_kernel_TimelineItem` is a redeclaration error. The view
// cluster therefore could not ship a Swift typed-sidecar binding until the
// table was defined exactly ONCE.
//
// This file is the single definition. The two consumer schemas `include` it (an
// `include` must precede the `namespace`), so `flatc` (run WITHOUT `--gen-all`)
// emits `TimelineItem` only in `timeline_item_generated.{rs,swift}` and the
// per-key files merely REFERENCE it. This mirrors the established
// `profile_card.fbs` pattern in this same directory.
//
// Wire format: this is a PURE schema reorganisation. `TimelineItem`'s field
// order and types are byte-identical to the prior inlined copies, so every
// encoded buffer is unchanged. The Rust encode tests in `nmp-core` are the
// empirical proof.
//
// D0: a `TimelineItem` carries only generic timeline-content fields (id,
// author_pubkey, kind, content, timestamps, relay count) — no
// protocol-specific (NIP-NN) semantics, so it is kernel-owned and typed here.
// D6: decoders return `Err(String)` on malformed input, never panic.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh:
//   flatc --rust -o crates/nmp-core/src/kernel/typed_projections/generated \
//         crates/nmp-core/schema/timeline_item.fbs

table TimelineItem {
  // Hex event id.
  id:string;
  // Author hex pubkey.
  author_pubkey:string;
  // Picture URL from kind:0; `has_author_picture_url == false` mirrors JSON
  // `null` / absent.
  has_author_picture_url:bool;
  author_picture_url:string;
  // NIP-57 lightning address / LNURL; `has_author_lnurl == false` mirrors JSON
  // `null` / absent.
  has_author_lnurl:bool;
  author_lnurl:string;
  // Display name from kind:0; `has_author_display_name == false` mirrors JSON
  // `null` / absent.
  has_author_display_name:bool;
  author_display_name:string;
  // Nostr event kind number.
  kind:uint;
  // Raw event content.
  content:string;
  // Pre-rendered content preview (aim.md §6 AP1 — Rust owns this).
  content_preview:string;
  // Unix epoch seconds.
  created_at:ulong;
  // Number of relays that confirmed the event.
  relay_count:uint;
  // True when this item is a kind:6 repost.
  is_repost:bool;
  // Navigation target event id (for reposts: the inner event id; otherwise
  // the item's own id).
  nav_target_id:string;
  // Inner content for reposts (the JSON-serialised inner event); empty for
  // non-reposts.
  repost_inner_content:string;
}
