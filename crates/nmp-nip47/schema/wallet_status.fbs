namespace nmp.nip47;

// Typed FlatBuffers wire for `nmp_nip47::WalletStatus` (the app noun projected
// onto the snapshot under `projections["wallet"]`).
//
// This is the typed sidecar counterpart to the authoritative serde JSON of
// `WalletStatus`: the generic `Value` projection stays the source of truth
// (`apps/chirp/.../wallet_runtime.rs` still registers it), and this buffer is
// emitted ALONGSIDE it in every `SnapshotFrame`'s `typed_projections` sidecar
// (ADR-0037). A host with a `NWST` decoder prefers this typed payload; an
// un-updated host falls back to the generic `Value` subtree. Purely additive.
//
// RAW-DATA DOCTRINE (aim.md §2 / ADR-0032 /
// docs/wiki/guides/shell-formatting-boundary.md): this buffer carries ONLY raw
// semantic tokens — never pre-rendered English labels, tone strings, or
// display-formatted numbers. Shells render the status label, semantic tone, and
// thousands-separated balance themselves from the raw `status` token +
// `balance_sats`. The earlier `status_label` / `status_tone` /
// `balance_sats_display` precompute fields were a presentation regression (#623)
// and were removed in the wallet_status sweep (analogous to the #1580
// signer-state sweep).
//
// Field-for-field mirror of the Rust struct (raw protocol values only):
//   * String fields are required (non-optional in the serde struct).
//   * `Option<...>` fields carry a `has_*` presence flag plus the value, so
//     absent (`None`) round-trips distinctly from a present default — the same
//     optional-fields convention used by content_tree.fbs / op_feed.fbs.
//   * `Option<NwcConnectionState>` is the `connection_state` enum + its
//     `has_connection_state` flag.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// has no `include`, so generate plainly:
//   flatc --rust -o crates/nmp-nip47/src/wire/generated \
//         crates/nmp-nip47/schema/wallet_status.fbs
//
// Regenerate Swift bindings (FlatBuffers 25.12.19):
//   flatc --swift -o apps/chirp/ios/Chirp/Bridge/Generated \
//         crates/nmp-nip47/schema/wallet_status.fbs
//
// Regenerate Kotlin bindings (FlatBuffers 25.2.10 — the Android/Kotlin runtime
// pin set by `flatbuffers-java:25.2.10` in apps/chirp/android/app/build.gradle.kts, and
// enforced by ci/check-flatbuffers-version-pins.sh's FLATBUFFERS_25_2_10()
// guard. This is DISTINCT from the Rust/Swift pin 25.12.19 above: every Kotlin
// binding under apps/chirp/android/app/src/main/java/nmp must use 25.2.10 or the runtime
// version guard call (Constants.FLATBUFFERS_25_2_10()) will not exist and the
// Android build will fail to compile):
//   flatc --kotlin -o apps/chirp/android/app/src/main/java \
//         crates/nmp-nip47/schema/wallet_status.fbs

// Coarse-grained NWC transport-health state (`nmp_nip47::NwcConnectionState`).
enum NwcConnectionState:ubyte { Connected = 0, Reconnecting = 1, TransportLost = 2 }

table WalletStatus {
  // "connecting" | "ready" | "error" | "disconnected"
  status:string;
  // The NWC relay URL (from the connection URI).
  relay_url:string;
  // The wallet service pubkey in bech32 npub form.
  wallet_npub:string;
  // balance_msats: Option<u64>
  has_balance_msats:bool;
  balance_msats:uint64;
  // balance_sats: Option<u64>. Shells apply their own thousands-separator
  // formatting when rendering (raw-data doctrine).
  has_balance_sats:bool;
  balance_sats:uint64;
  // `wallet_npub_short` removed (#1678, D7): shells abbreviate `wallet_npub`
  // themselves.  Vtable slot reserved to prevent accidental reuse.
  _reserved_was_wallet_npub_short:string (deprecated);
  // status == "ready"
  is_ready:bool;
  // status == "connecting" || status == "ready"
  is_connected:bool;
  // connection_state: Option<NwcConnectionState>
  has_connection_state:bool;
  connection_state:NwcConnectionState;
  // The wallet service pubkey in raw hex form (64 chars). Required (non-optional
  // in the serde struct). Tail-appended (wire-compatible additive field) so an
  // older host that predates it still decodes every prior field.
  wallet_pubkey_hex:string;
}

file_identifier "NWST";
root_type WalletStatus;
