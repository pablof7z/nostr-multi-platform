namespace nmp.nip57;

// Typed FlatBuffers wire for `nmp_nip57::ZapsAggregateSnapshot` (the app noun
// projected onto the snapshot under `projections["nmp.nip57.zaps"]`).
//
// This is the typed sidecar counterpart to the authoritative serde JSON of
// `ZapsAggregateSnapshot`: the generic `Value` projection stays the source of
// truth (`apps/chirp/.../ffi/register.rs` still registers it via
// `register_snapshot_projection`), and this buffer is emitted ALONGSIDE it in
// every `SnapshotFrame`'s `typed_projections` sidecar (ADR-0037). A host with
// an `NZAP` decoder prefers this typed payload; an un-updated host falls back
// to the generic `Value` subtree. Purely additive.
//
// Field-for-field mirror of the Rust struct (raw protocol values only):
//   * `ZapsAggregateSnapshot { totals: HashMap<EventId, ZapCount> }` becomes a
//     flattened `[ZapTotal]` vector — FlatBuffers has no map type, so each map
//     entry is one `ZapTotal { target_event_id, total_msats, count }`.
//     `EventId` is a hex string (`type EventId = String`), carried verbatim.
//   * `ZapCount { total_msats: u64, count: u32 }` mirrors both fields — `count`
//     is kept (the brief's inline `{ msats }` example was illustrative; the
//     authoritative DTO carries both the summed msats AND the receipt count,
//     which the timeline surface renders distinctly).
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// has no `include`, so generate plainly:
//   flatc --rust -o crates/nmp-nip57/src/wire/generated \
//         crates/nmp-nip57/schema/zaps.fbs

// One target event's aggregate zap totals (`nmp_nip57::ZapCount` keyed by its
// zapped event id).
table ZapTotal {
  // The zapped event id (hex). Map key in the Rust `totals` HashMap.
  target_event_id:string;
  // ZapCount.total_msats — summed bolt11 amount over all distinct receipts.
  total_msats:uint64;
  // ZapCount.count — number of distinct receipts indexed under this target.
  count:uint32;
}

table ZapsSnapshot {
  // The `totals` map flattened to a vector (one entry per zapped target).
  totals:[ZapTotal];
}

file_identifier "NZAP";
root_type ZapsSnapshot;
