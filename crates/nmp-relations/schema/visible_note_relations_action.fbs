namespace nmp.nip01;

// ADR-0064 / S9 (#1747) — typed FlatBuffers payload for the
// `nmp.nip01.visible_note_relations` `ActionModule` (Claim/Release a tailing
// interest across all relation kinds for one note).
//
// The OPAQUE `DispatchEnvelope.payload` for that namespace; the registry
// adapter decodes against THIS schema, gating `schema_version` BEFORE
// `start()` (fail-closed on mismatch). WRITE-direction action payload.
//
// The Claim/Release discriminator is modelled as a tagged-table enum rather
// than a FlatBuffers union (cross-platform-stability; same reasoning as
// `bookmark_update.fbs`). The `op` field selects exactly which operation
// the payload represents; both variants carry the same `event_id` /
// `consumer_id` fields.
//
// Self-contained (no `include`). Regenerate the checked-in Rust bindings
// only with the workspace FlatBuffers pin (25.12.19):
//   flatc --rust -o crates/nmp-relations/src/wire/generated \
//         crates/nmp-relations/schema/visible_note_relations_action.fbs

enum VisibleNoteRelationsOp:ubyte {
  Claim = 0,
  Release = 1,
}

table VisibleNoteRelationsPayload {
  // Fail-closed schema_version tripwire (read RAW before decode).
  schema_version:uint;
  // Operation discriminator: Claim opens the tailing interest, Release drops
  // the interest owner reference.
  op:VisibleNoteRelationsOp;
  // 64-hex Nostr event-id of the note whose relations are claimed/released.
  // Validation stays in `start()`; this is a pure shape decode.
  event_id:string (required);
  // Caller-scoped consumer identifier for ref-counted interest ownership.
  consumer_id:string (required);
}

file_identifier "NR01";
root_type VisibleNoteRelationsPayload;
