namespace nmp.relations;

// Typed FlatBuffers wire for the cross-protocol notification snapshot.
//
// The producer is `nmp_relations::NotificationsProjection`, a bounded observed
// projection over interaction events that p-tag the active account. Raw Nostr
// facts only: the shell may format times, shorten ids, and choose icons, but it
// must not classify events or own notification state.

table NotificationRow {
  event_id:string;
  actor_pubkey:string;
  event_kind:uint32;
  notification_kind:string;
  created_at:ulong;
  content:string;
  target_event_id:string;
  source_relays:[string];
  read:bool;
}

table NotificationsSnapshot {
  schema_version:uint32 = 1;
  viewer_pubkey:string;
  rows:[NotificationRow];
  unread_count:uint32;
}

root_type NotificationsSnapshot;
file_identifier "NNTF";
