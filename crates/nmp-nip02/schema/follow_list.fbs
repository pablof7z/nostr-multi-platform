namespace nmp.nip02;

// Typed FlatBuffers wire for the `nmp_nip02::FollowListProjection` snapshot (the
// app noun projected onto the snapshot under `projections["nmp.follow_list"]`).
//
// This is the typed sidecar counterpart to the authoritative serde JSON of the
// follow-list snapshot: the generic `Value` projection stays the source of
// truth (`apps/chirp/.../ffi/register.rs` still registers it via
// `register_snapshot_projection` under the key `"nmp.follow_list"`), and this
// buffer is emitted ALONGSIDE it in every `SnapshotFrame`'s `typed_projections`
// sidecar (ADR-0072). A host with an `NF02` decoder prefers this typed payload;
// an un-updated host falls back to the generic `Value` subtree. Purely
// additive.
//
// Note the deliberate key/schema_id split (same convention wallet used):
//   * registration KEY (the namespace in the snapshot tree): "nmp.follow_list"
//   * SCHEMA_ID (this typed payload's stable identity):     "nmp.nip02.follow_list"
//
// Field-for-field mirror of the Rust snapshot shape `{ follows: [FollowEntry] }`
// where `FollowEntry { pubkey: String }` carries only the raw hex pubkey
// (presentation formatting is a host concern — aim.md §2).
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// has no `include`, so generate plainly:
//   flatc --rust -o crates/nmp-nip02/src/wire/generated \
//         crates/nmp-nip02/schema/follow_list.fbs

// One followed account — raw hex pubkey only (`nmp_nip02::FollowEntry`).
table FollowEntry {
  // Hex-encoded public key (64 chars).
  pubkey:string;
}

table FollowListSnapshot {
  // The active account's follow list (empty when no account / no kind:3 yet).
  follows:[FollowEntry];
}

file_identifier "NF02";
root_type FollowListSnapshot;
