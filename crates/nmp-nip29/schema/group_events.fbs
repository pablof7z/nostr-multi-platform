namespace nmp.nip29;

// Typed FlatBuffers wire for the NIP-29 group-events snapshot projection
// (`nmp_nip29::projection::GroupEventsSnapshot`), schema_id
// "nmp.nip29.group_events".
//
// NIP-29 is a kind-agnostic group transport (issue #2187): this projection
// accumulates the h-tagged group events the CONSUMER asked for and exposes the
// kind per event. A "chat view" is a consumer that declared kinds {9, 11}; the
// projection itself bakes in no kind policy.
//
// This is the typed sidecar (ADR-0072) carried alongside the existing generic
// `serde_json::Value` projection registered under the same key by the NIP-29
// group-events typed read session. The serde shape
// (`GroupEventsProjection::snapshot_json`) stays authoritative; this buffer
// mirrors it byte-for-byte in field semantics so a host with a `NGEV` decoder
// can read typed accessors instead of JSON reflection. An un-updated host falls
// back to the generic `Value` subtree (the permanent fallback from ADR-0072).
//
// Raw data only (ADR-0072): every field is the raw protocol value — hex event
// ids / pubkeys, verbatim content, Unix-second `created_at`, raw kind. No
// `display::` forwarder runs on the encode path.
//
// Identity encoding: strings, not raw bytes — `id` / `pubkey` are hex `String`
// in the source serde types, so `string` is byte-for-byte parity (the same
// per-schema choice documented in timeline_snapshot.fbs / op_feed.fbs).
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// is self-contained (no `include`), so generate with plain `flatc --rust`:
//
//   flatc --rust -o crates/nmp-nip29/src/wire/generated \
//         crates/nmp-nip29/schema/group_events.fbs

// One group event. A flat carrier mirroring `nmp_nip29::GroupEvent` exactly.
//
// NIP-29 is kind-blind transport (issue #2517): it carries the `h` / `previous`
// / host-pin envelope only and does NOT interpret NIP-10 reply/thread (`e`-tag
// root/reply/mention) markers — that foreign-protocol concept is owned by
// `nmp-threading`. So this carrier ships no `reply_to` / `root` thread edge; a
// threading read model resolves those from the same `e` tags downstream.
table GroupEvent {
  id:string;            // raw hex event id (also the projection dedupe key)
  pubkey:string;        // raw hex author pubkey (64 chars)
  content:string;       // event content, verbatim
  created_at:uint64;    // event created_at, Unix seconds
  kind:uint32;          // event kind (e.g. 9 chat, 11 thread, 1111 comment)
}

// The serialised group-events read model. `events` is ordered newest-first
// (`created_at` descending, ties broken by id descending) — the encoder ships
// the snapshot order verbatim.
table GroupEventsSnapshot {
  schema_version:uint32 = 3;   // mirrors GROUP_EVENTS_SCHEMA_VERSION
  events:[GroupEvent];
}

root_type GroupEventsSnapshot;
file_identifier "NGEV";
