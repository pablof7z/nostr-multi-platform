namespace nmp.nip29;

// Typed FlatBuffers wire for `nmp_nip29::projection::JoinedGroupsSnapshot`,
// schema_id "nmp.nip29.joined_groups". The serde snapshot remains the
// authoritative Rust shape; this sidecar mirrors it for typed host decoders.

table JoinedGroup {
  group_id:string;
  host_relay_url:string;
  name:string;
  picture:string;
  about:string;
  member_count:uint32;
  admin_count:uint32;
  public:bool;
  open:bool;
  is_member:bool;
  is_admin:bool;
  // NIP-29 subgroups (nips PR #2319): `["parent", <id>]` on the latest 39000.
  // Absent/empty == root. Populated only when a 39000 arrives (the
  // joined-groups interest subscribes to 39001/39002 by default).
  parent:string;
  // NIP-29 subgroups: ordered `["child", <id>]` values on the latest 39000.
  children:[string];
}

table JoinedGroupsSnapshot {
  schema_version:uint32 = 2;
  active_pubkey:string;
  groups:[JoinedGroup];
}

root_type JoinedGroupsSnapshot;
file_identifier "NJGS";
