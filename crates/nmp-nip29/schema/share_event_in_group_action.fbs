namespace nmp.nip29;

// ADR-0064 / S9 (#1747) — typed FlatBuffers payload for the
// `nmp.nip29.share_event_in_group` `ActionModule` (publishes a host-pinned
// kind:11 group event).
//
// The OPAQUE `DispatchEnvelope.payload` for that namespace; the registry adapter
// decodes against THIS schema, gating `schema_version` BEFORE `start()`
// (fail-closed on mismatch). WRITE-direction action payload.
//
// Self-contained (no `include`). Regenerate the checked-in Rust bindings only
// with the workspace FlatBuffers pin (25.12.19):
//   flatc --rust -o crates/nmp-nip29/src/wire/generated \
//         crates/nmp-nip29/schema/share_event_in_group_action.fbs

table GroupRef {
  host_relay_url:string (required);
  local_id:string (required);
}

// The event being shared/reposted: an event id plus an optional `p` author.
table GroupEventTarget {
  // `start()` rejects an empty event_id — preserved verbatim.
  event_id:string (required);
  // Optional `p` tag author; presence preserved.
  author_pubkey:string;
}

// One free-form additional tag (`["t","nostr"]` etc). A wrapper table is needed
// because FlatBuffers cannot nest `[[string]]` directly.
table StringTag {
  values:[string];
}

table ShareEventInGroupPayload {
  schema_version:uint;
  group:GroupRef (required);
  target:GroupEventTarget (required);
  // Optional content; defaults to empty when absent.
  content:string;
  additional_tags:[StringTag];
}

file_identifier "N29S";
root_type ShareEventInGroupPayload;
