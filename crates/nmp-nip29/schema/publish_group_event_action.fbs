namespace nmp.nip29;

// ADR-0064 / S9 (#1747) — typed FlatBuffers payload for the generic
// `nmp.nip29.publish_group_event` `ActionModule`.
//
// This is the SINGLE app-facing surface for authoring any event into a NIP-29
// group: the app supplies the `kind`, `content`, and any kind-specific `tags`,
// and nmp-nip29 injects the group envelope (the `["h", local_id]` tag, the
// `["previous", …]` timeline-reference tags, and the host-relay pin) at publish
// time. NIP-29 owns the envelope, not the event kind — "chat" is just kind:9.
//
// The OPAQUE `DispatchEnvelope.payload` for that namespace; the registry adapter
// decodes against THIS schema, gating `schema_version` BEFORE `start()`
// (fail-closed on mismatch). WRITE-direction action payload.
//
// Self-contained (no `include`). Regenerate the checked-in Rust bindings only
// with the workspace FlatBuffers pin (25.12.19):
//   flatc --rust -o crates/nmp-nip29/src/wire/generated \
//         crates/nmp-nip29/schema/publish_group_event_action.fbs

table GroupRef {
  host_relay_url:string (required);
  local_id:string (required);
}

// One free-form caller tag (`["e", id, "", "reply"]`, `["t","nostr"]`, …). A
// wrapper table is needed because FlatBuffers cannot nest `[[string]]` directly.
// The NIP-29 envelope tags (`h` / `previous`) are NEVER carried here — they are
// injected by nmp-nip29; `start()` rejects caller-supplied `h` / `previous`.
table StringTag {
  values:[string];
}

table PublishGroupEventPayload {
  schema_version:uint;
  group:GroupRef (required);
  // The event kind to author into the group (e.g. 9 chat, 11 thread, 7 react).
  kind:uint;
  // Optional content; defaults to empty when absent.
  content:string;
  // Caller-supplied event tags, excluding the NIP-29 envelope tags.
  tags:[StringTag];
}

file_identifier "N29G";
root_type PublishGroupEventPayload;
