namespace nmp.nip29;

// ADR-0064 / S9 (#1747) — typed FlatBuffers payload for the
// `nmp.nip29.post_chat_message` `ActionModule` (publishes a kind:9 chat
// message).
//
// The OPAQUE `DispatchEnvelope.payload` for that namespace; the registry adapter
// decodes against THIS schema, gating `schema_version` BEFORE `start()`
// (fail-closed on mismatch). WRITE-direction action payload.
//
// Self-contained (no `include`). Regenerate the checked-in Rust bindings only
// with the workspace FlatBuffers pin (25.12.19):
//   flatc --rust -o crates/nmp-nip29/src/wire/generated \
//         crates/nmp-nip29/schema/post_chat_message_action.fbs

table GroupRef {
  host_relay_url:string (required);
  local_id:string (required);
}

table PostChatMessagePayload {
  schema_version:uint;
  group:GroupRef (required);
  // The chat body. `start()` rejects an empty body — preserved verbatim here.
  content:string (required);
  // Event-id prefixes from the per-group recent-events cache.
  previous_event_id_prefixes:[string];
  // Optional reply target; presence preserved.
  reply_to_event_id:string;
}

file_identifier "N29C";
root_type PostChatMessagePayload;
