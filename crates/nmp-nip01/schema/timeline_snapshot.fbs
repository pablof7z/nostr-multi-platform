// Typed FlatBuffers wire for `nmp_nip01::ModularTimelineSnapshot`.
//
// This low-layer NIP crate owns NIP-10 timeline grouping only. Concrete feed
// items/cards, profile display, repost composition, relation counts, and render
// payloads belong to higher composition/concept owners.

namespace nmp.nip01;

enum ThreadPointerKind:ubyte {
  Event = 0,
  Address = 1,
  External = 2,
}

table ThreadPointer {
  kind:ThreadPointerKind;
  id:string;
  coord:string;
  uri:string;
  relay:string;
  has_kind_num:bool;
  kind_num:uint32;
}

enum TimelineBlockKind:ubyte {
  Standalone = 0,
  Module = 1,
}

table BlockEventId {
  id:string;
}

table TimelineBlockEntry {
  kind:TimelineBlockKind;
  standalone_id:string;
  standalone_root:ThreadPointer;
  module_event_ids:[BlockEventId];
  module_has_gap:bool;
  module_root:ThreadPointer;
}

table ModularTimelineSnapshot {
  schema_version:uint32 = 3;
  blocks:[TimelineBlockEntry];
}

root_type ModularTimelineSnapshot;
file_identifier "NFTS";
