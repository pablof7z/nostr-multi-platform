[package]
name = "{{facade_pkg}}"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "{{display}} app-owned UniFFI facade over nmp-native-runtime."

[lib]
# `staticlib` lets iOS link the app facade, `cdylib` lets UniFFI generate
# Swift/Kotlin bindings from the library, and `rlib` keeps Rust smoke tests
# and desktop/headless hosts on the normal Rust path.
crate-type = ["staticlib", "cdylib", "rlib"]

[dependencies]
{{pkg}} = { path = "../{{pkg}}" }
nmp-native-runtime = {{nmp_native_runtime_dep}}
nmp-uniffi-support = {{nmp_uniffi_support_dep}}
nmp-core = {{nmp_core_dep}}
uniffi = { version = "0.29" }

[features]
# `bindgen` gates the facade's own `uniffi-bindgen` binary behind an opt-in
# feature so normal `cargo build`/`cargo check` never links the UniFFI CLI.
# There is no shared framework bindgen crate to borrow (#2763 deleted
# `nmp-uniffi`); each app-owned facade carries its own bindgen entry point
# over its own cdylib.
bindgen = ["uniffi/cli"]

[[bin]]
name = "uniffi-bindgen"
path = "src/bin/uniffi-bindgen.rs"
required-features = ["bindgen"]
