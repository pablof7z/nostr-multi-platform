//! `{{pkg}}` — the app-specific core for `{{display}}`, scaffolded by
//! `nmp init {{name}}`.
//!
//! # Composition is a library (ADR-0046)
//!
//! This crate is a **thin composition shell**. [`register`] inherits the
//! canonical NMP composition by calling
//! [`nmp_defaults::register_defaults`] — one call that wires the
//! NIP-01/02/17/57/65 action modules, the production routing substrate, the
//! DM-inbox + zap-receipts + WOT runtime controllers, and the long-form typed
//! projection. This is the Bevy-`DefaultPlugins` / Spring-Boot-starter
//! pattern: you depend on the framework's default composition, you do not
//! generate it.
//!
//! After `register_defaults`, register your app-specific modules (the example
//! domain below shows the kernel boundary). Then drive the lifecycle through
//! `NmpAppBuilder` — see `examples/shell.rs`.
//!
//! # D0 — app nouns live here, never in `nmp-core`
//!
//! Per cardinal doctrine **D0**, app nouns never live in `nmp-core` —
//! `EntryRecord` and friends are defined *here*, and the kernel stays generic:
//!
//! * [`EntryViewModule`] — a reactive view over your records. Its `open` /
//!   `on_event_*` / `snapshot` methods are plain inherent methods reached via
//!   static dispatch; there is no `ViewModule` trait.
//! * [`EntryActionModule`] — an `ActionModule` that validates and accepts
//!   input.
//!
//! Replace `Entry` with your real domain.

use nmp_core::substrate::*;
use serde::{Deserialize, Serialize};

/// Inherit the canonical NMP composition into `app`, then wire this app's own
/// modules on top.
///
/// MUST be called after `nmp_app_new` / `NmpAppBuilder::new` and BEFORE
/// `start` — every registration must be visible to the kernel when the first
/// event arrives (late wiring is dropped silently per D6).
///
/// The single `register_defaults` call is the whole point of ADR-0046: a new
/// Nostr app inherits the framework's default composition through a library
/// call, not a generated FFI crate.
pub fn register(app: &mut impl AppHost) {
    // 1. Inherit the canonical NMP composition (NIP action modules, routing
    //    substrate, DM-inbox + zap-receipts + WOT runtimes, …).
    nmp_defaults::register_defaults(app);

    // 2. Register this app's own modules here, e.g.:
    //    app.register_action(EntryActionModule);
    //    (ADR-0052: `register_action` takes the module VALUE — a stateful
    //    module owns its dependencies, captured here at composition time.
    //    See `nmp-defaults`'s `register_defaults` source for how the canonical
    //    NIP modules are wired — your app modules follow the same `AppHost`
    //    seam.)
}

/// The app module identifier. Namespaces below derive from it.
pub const APP_MODULE: &str = "{{name}}.entries";

/// An app-owned record. This is a *generic* example — not a social-app
/// noun. Make it whatever your app stores.
#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub struct EntryRecord {
    pub id: String,
    pub label: String,
    pub archived: bool,
}

// ---------------------------------------------------------------------------
// View
// ---------------------------------------------------------------------------

#[derive(Clone, Debug, Deserialize, Eq, Hash, PartialEq, Serialize)]
pub struct EntryListSpec {
    pub include_archived: bool,
}

#[derive(Clone, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]
pub struct EntryListView {
    pub items: Vec<EntryRecord>,
    pub active_count: usize,
}

#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub enum EntryDelta {
    Replaced { payload: EntryListView },
}

#[derive(Clone, Debug, Default)]
pub struct EntryViewState {
    payload: EntryListView,
}

/// A reactive view over [`EntryRecord`]s. Its methods are plain inherent
/// methods reached via static dispatch (`EntryViewModule::open(...)`); there
/// is no kernel-side `ViewModule` trait or registry.
pub struct EntryViewModule;

impl EntryViewModule {
    pub const NAMESPACE: &'static str = "{{name}}.entries.view";

    pub fn key(spec: &EntryListSpec) -> bool {
        spec.include_archived
    }

    pub fn dependencies(_spec: &EntryListSpec) -> ViewDependencies {
        ViewDependencies::default()
    }

    pub fn open(
        _ctx: &ViewContext,
        _spec: EntryListSpec,
    ) -> (EntryViewState, EntryListView) {
        let payload = EntryListView::default();
        (
            EntryViewState {
                payload: payload.clone(),
            },
            payload,
        )
    }

    pub fn on_event_inserted(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _event: &KernelEvent,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_event_removed(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _id: &EventId,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_event_replaced(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _old_id: &EventId,
        _new_event: &KernelEvent,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_projection_changed(
        _ctx: &ViewContext,
        state: &mut EntryViewState,
        _change: &ProjectionChange,
    ) -> Option<EntryDelta> {
        Some(EntryDelta::Replaced {
            payload: state.payload.clone(),
        })
    }

    pub fn snapshot(_ctx: &ViewContext, state: &EntryViewState) -> EntryListView {
        state.payload.clone()
    }
}

// ---------------------------------------------------------------------------
// Action
// ---------------------------------------------------------------------------

#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub enum Action {
    Add { id: String, label: String },
    Archive { id: String },
}

pub struct EntryActionModule;

impl ActionModule for EntryActionModule {
    const NAMESPACE: &'static str = "{{name}}.entries.action";

    type Action = Action;

    fn start(
        &self,
        _ctx: &mut ActionContext,
        action: Self::Action,
    ) -> Result<(), ActionRejection> {
        if matches!(&action, Action::Add { label, .. } if label.trim().is_empty()) {
            return Err(ActionRejection::Invalid("entry label is empty".to_string()));
        }
        Ok(())
    }

    fn execute(
        &self,
        _ctx: &ActionContext,
        _action: Self::Action,
        _correlation_id: &str,
        _send: &dyn Fn(nmp_core::actor::ActorCommand),
    ) -> Result<(), String> {
        // Scaffold placeholder: send an nmp_core::actor::ActorCommand via `send(...)` to
        // drive the actor. Host state can be captured in the closure passed
        // to `NmpApp::register_snapshot_projection` on the output side.
        Ok(())
    }
}

// ---------------------------------------------------------------------------
// Assembly
// ---------------------------------------------------------------------------

/// Module namespaces this app contributes.
pub fn module_namespaces() -> [&'static str; 2] {
    [
        EntryViewModule::NAMESPACE,
        EntryActionModule::NAMESPACE,
    ]
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn declares_two_distinct_module_namespaces() {
        let mut namespaces = module_namespaces().to_vec();
        namespaces.sort_unstable();
        namespaces.dedup();

        assert_eq!(namespaces.len(), 2);
        assert!(namespaces.iter().any(|ns| ns.ends_with(".view")));
        assert!(namespaces.iter().any(|ns| ns.ends_with(".action")));
    }

    #[test]
    fn action_rejects_empty_label() {
        let mut ctx = ActionContext::default();
        // ADR-0052: `start` takes `&self`; call on the (unit) module value.
        let result = EntryActionModule.start(
            &mut ctx,
            Action::Add {
                id: "1".to_string(),
                label: "  ".to_string(),
            },
        );

        assert_eq!(
            result,
            Err(ActionRejection::Invalid("entry label is empty".to_string()))
        );
    }
}
