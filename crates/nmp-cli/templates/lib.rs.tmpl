//! `{{pkg}}` — the app-specific core for `{{display}}`, scaffolded by
//! `nmp init {{name}}`.
//!
//! # Explicit feature composition (ADR-0069)
//!
//! This crate is a **thin composition shell** and starter contract. [`register`]
//! installs the reusable NMP substrate floor plus selected protocol/runtime
//! installers explicitly, then leaves product app-owned modules visible in this
//! app root. You depend on the crates that own each feature; you do not
//! generate or copy framework wiring, and you do not hide production policy
//! behind a wholesale preset.
//!
//! After the substrate call, register selected protocol features and your
//! app-specific modules (the example domain below shows the kernel boundary).
//! Then drive the lifecycle through `NmpAppBuilder` — see `examples/shell.rs`.
//!
//! # D0 — app nouns live here, never in `nmp-core`
//!
//! Per cardinal doctrine **D0**, app nouns never live in `nmp-core` —
//! `EntryRecord` and friends are defined *here*, and the kernel stays generic:
//!
//! * [`EntryViewModule`] — a reactive view over your records. Its `open` /
//!   `on_event_*` / `snapshot` methods are plain inherent methods reached via
//!   static dispatch; there is no `ViewModule` trait.
//! * [`EntryActionModule`] — an `ActionModule` that validates and accepts
//!   input.
//!
//! Replace `Entry` with your real domain.

use nmp_core::substrate::*;
use serde::{Deserialize, Serialize};

/// Install the reusable NMP substrate into `app`, then wire this app's own
/// modules and selected protocol features on top.
///
/// MUST be called after constructing the native runtime app/builder and BEFORE
/// `start` — every registration must be visible to the kernel when the first
/// event arrives (late wiring is dropped silently per D6).
///
pub fn register(app: &mut impl AppHost) {
    // 1. Install the reusable substrate floor: routing, mailbox/profile/contact
    //    caches, parsers, publish resolver, external event forwarding, coverage
    //    gate, and NIP-77 sync hooks. This is correctness plumbing, not product
    //    policy.
    let _substrate_handles = nmp_substrate::install(app, nmp_substrate::SubstrateConfig::default());

    // 2. Install reusable Nostr protocol/runtime features by owner crate. This
    //    keeps every selected layer grep-able for starter apps.
    nmp_nip50::register_search_scopes(app);
    nmp_nip50::register_input_scopes(app);
    nmp_nip02::register_follow_actions(app);
    nmp_replies::register_actions(app);
    nmp_core::substrate::ProtocolDescriptor::register_actions(&nmp_nip25::Nip25Descriptor, app);
    nmp_core::substrate::ProtocolDescriptor::register_actions(&nmp_nip18::Nip18Descriptor, app);
    nmp_core::substrate::ProtocolDescriptor::register_actions(&nmp_nip84::Nip84Descriptor, app);
    nmp_nip29::register_input_scopes(app);
    let _wot_runtime = nmp_wot::register_runtime(app);
    let _mute_runtime = nmp_nip51::register_mute_runtime(app);
    let _bookmark_runtime = nmp_nip51::register_bookmark_runtime(app);
    nmp_nip51::register_bookmark_set_runtime(app);
    nmp_nip51::register_web_bookmark_runtime(app);
    let _search_relay_runtime = nmp_nip51::register_search_relay_runtime_with_fallbacks(
        app,
        nmp_nip50::SearchFallbackRelays::default(),
    );
    nmp_nip17::register_actions(app);
    nmp_nip17::register_runtime(app);
    let _comment_runtime = nmp_nip22::register_runtime(app);
    nmp_nip23::register_longform_projection(app);

    // 3. Register this app's own modules here, e.g.:
    //    app.register_action(EntryActionModule);
    //    (ADR-0052: `register_action` takes the module VALUE — a stateful
    //    module owns its dependencies, captured here at composition time.
    //    App modules follow the same `AppHost` seam as the protocol installers.)
}

/// The app module identifier. Namespaces below derive from it.
pub const APP_MODULE: &str = "{{name}}.entries";

pub const HOME_TIMELINE_PROJECTION: &str = "{{name}}.timeline.home";
pub const PROFILE_REF_PROJECTION: &str = "refs.profile";
pub const EVENT_REF_PROJECTION: &str = "refs.event";
pub const EVENT_ENVELOPES_PROJECTION: &str = "refs.event.envelopes";
pub const PUBLISH_OUTBOX_PROJECTION: &str = "publish_outbox";
pub const STARTER_PRIMARY_NOTE_KIND: u32 = 1;

/// Projection keys this starter is built around: timeline, profile rows,
/// authoritative event refs, derived embed envelopes, and publish feedback.
pub fn starter_projection_keys() -> [&'static str; 5] {
    [
        HOME_TIMELINE_PROJECTION,
        PROFILE_REF_PROJECTION,
        EVENT_REF_PROJECTION,
        EVENT_ENVELOPES_PROJECTION,
        PUBLISH_OUTBOX_PROJECTION,
    ]
}

/// Kernel built-in projection keys declared through ADR-0053 before `start()`.
///
/// Tier-1 projections such as [`HOME_TIMELINE_PROJECTION`] and
/// [`EVENT_ENVELOPES_PROJECTION`] are runtime/protocol projections that
/// self-gate by registration. Only kernel built-ins are passed to
/// `declare_consumed_projections`.
pub fn starter_builtin_projection_keys() -> [&'static str; 3] {
    [
        PROFILE_REF_PROJECTION,
        EVENT_REF_PROJECTION,
        PUBLISH_OUTBOX_PROJECTION,
    ]
}

/// Typed app-owned feed declaration for the starter read surface.
///
/// A real platform shell opens this feed through the runtime and renders the
/// emitted projection. The shell does not derive relay policy, parse protocol
/// wrappers, or keep a domain cache.
pub fn starter_home_feed_params() -> nmp_native_runtime::FeedParams {
    nmp_native_runtime::FeedParams {
        primary_kinds: vec![STARTER_PRIMARY_NOTE_KIND],
        shape: nmp_native_runtime::FeedShape::RootIndexed,
        source: nmp_native_runtime::FeedSourceExpr::ActiveUserFollows,
        admission: nmp_native_runtime::FeedAdmission::All,
        order: nmp_native_runtime::FeedOrder::NewestByFeedPosition,
        window: nmp_native_runtime::FeedWindowPolicy::bounded(80),
        key: nmp_native_runtime::ProjectionKey::app_owned(HOME_TIMELINE_PROJECTION)
            .expect("starter home timeline projection is app-owned"),
        item_projection: nmp_native_runtime::FeedItemProjection::FeedRows,
    }
}

/// Opaque handle for the starter home timeline session.
///
/// App code keeps this handle and passes it back to close the session. It does
/// not re-derive filters, own source reduction, or select a feed compiler.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct HomeTimelineSession {
    handle: nmp_native_runtime::FeedHandle,
}

impl HomeTimelineSession {
    #[must_use]
    pub fn projection_key(&self) -> &nmp_native_runtime::ProjectionKey {
        &self.handle.projection_key
    }
}

/// Open the starter home timeline as an app-owned typed read session.
///
/// This is the app-level read API. The helper builds the declaration and lets
/// the native runtime apply the reusable NMP compiler internally; callers
/// receive only the session they need to render and later close.
pub fn open_home_timeline_session(
    app: &nmp_native_runtime::NmpApp,
) -> Result<HomeTimelineSession, nmp_native_runtime::FeedOpenError> {
    let handle = app.open_feed(&starter_home_feed_params())?;
    Ok(HomeTimelineSession { handle })
}

/// Close a home timeline session opened by [`open_home_timeline_session`].
pub fn close_home_timeline_session(
    app: &nmp_native_runtime::NmpApp,
    session: HomeTimelineSession,
) -> bool {
    app.close_feed(&session.handle)
}

/// Host-side typed write builders this starter expects platform shells to use.
pub fn starter_action_builder_paths() -> [&'static str; 2] {
    [
        "GeneratedActionBuilders.publishReply",
        "GeneratedActionBuilders.publishProfile",
    ]
}

/// An app-owned record. This is a *generic* example — not a social-app
/// noun. Make it whatever your app stores.
#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub struct EntryRecord {
    pub id: String,
    pub label: String,
    pub archived: bool,
}

// ---------------------------------------------------------------------------
// View
// ---------------------------------------------------------------------------

#[derive(Clone, Debug, Deserialize, Eq, Hash, PartialEq, Serialize)]
pub struct EntryListSpec {
    pub include_archived: bool,
}

#[derive(Clone, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]
pub struct EntryListView {
    pub items: Vec<EntryRecord>,
    pub active_count: usize,
}

#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub enum EntryDelta {
    Replaced { payload: EntryListView },
}

#[derive(Clone, Debug, Default)]
pub struct EntryViewState {
    payload: EntryListView,
}

/// A reactive view over [`EntryRecord`]s. Its methods are plain inherent
/// methods reached via static dispatch (`EntryViewModule::open(...)`); there
/// is no kernel-side `ViewModule` trait or registry.
pub struct EntryViewModule;

impl EntryViewModule {
    pub const NAMESPACE: &'static str = "{{name}}.entries.view";

    pub fn key(spec: &EntryListSpec) -> bool {
        spec.include_archived
    }

    pub fn dependencies(_spec: &EntryListSpec) -> ViewDependencies {
        ViewDependencies::default()
    }

    pub fn open(
        _ctx: &ViewContext,
        _spec: EntryListSpec,
    ) -> (EntryViewState, EntryListView) {
        let payload = EntryListView::default();
        (
            EntryViewState {
                payload: payload.clone(),
            },
            payload,
        )
    }

    pub fn on_event_inserted(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _event: &KernelEvent,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_event_removed(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _id: &EventId,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_event_replaced(
        _ctx: &ViewContext,
        _state: &mut EntryViewState,
        _old_id: &EventId,
        _new_event: &KernelEvent,
    ) -> Option<EntryDelta> {
        None
    }

    pub fn on_projection_changed(
        _ctx: &ViewContext,
        state: &mut EntryViewState,
        _change: &ProjectionChange,
    ) -> Option<EntryDelta> {
        Some(EntryDelta::Replaced {
            payload: state.payload.clone(),
        })
    }

    pub fn snapshot(_ctx: &ViewContext, state: &EntryViewState) -> EntryListView {
        state.payload.clone()
    }
}

// ---------------------------------------------------------------------------
// Action
// ---------------------------------------------------------------------------

#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
pub enum Action {
    Add { id: String, label: String },
    Archive { id: String },
}

pub struct EntryActionModule;

impl ActionModule for EntryActionModule {
    const NAMESPACE: DeclaredActionNamespace =
        DeclaredActionNamespace::app_owned("{{name}}.entries.action");

    type Action = Action;

    fn start(
        &self,
        _ctx: &mut ActionContext,
        action: Self::Action,
    ) -> Result<(), ActionRejection> {
        if matches!(&action, Action::Add { label, .. } if label.trim().is_empty()) {
            return Err(ActionRejection::Invalid("entry label is empty".to_string()));
        }
        Ok(())
    }

    fn execute(
        &self,
        _ctx: &ActionContext,
        _action: Self::Action,
        _correlation_id: &str,
        _send: &dyn Fn(nmp_core::actor::ActorCommand),
    ) -> Result<(), String> {
        // Scaffold placeholder: send an nmp_core::actor::ActorCommand via
        // `send(...)` to drive the actor. Register typed outputs through the
        // AppHost substrate seams in this crate's composition root.
        Ok(())
    }
}

