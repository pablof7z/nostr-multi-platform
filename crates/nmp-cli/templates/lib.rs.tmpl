//! `{{pkg}}` — the app-specific core for `{{display}}`, scaffolded by
//! `nmp init {{name}}`.
//!
//! # Explicit feature composition (ADR-0069)
//!
//! This crate is a **thin composition shell** and starter contract. [`register`]
//! installs the reusable NMP substrate floor plus selected protocol/runtime
//! installers explicitly, then leaves product app-owned modules visible in this
//! app root. You depend on the crates that own each feature; you do not
//! generate or copy framework wiring, and you do not hide production policy
//! behind a wholesale preset.
//!
//! After the substrate call, register selected protocol features and your
//! app-specific modules (the example domain below shows the kernel boundary).
//! Then drive the lifecycle through `NmpAppBuilder` — see `examples/shell.rs`.
//!
//! # D0 — app nouns live here, never in `nmp-core`
//!
//! Per cardinal doctrine **D0**, app nouns never live in `nmp-core` —
//! `EntryRecord` and friends are defined *here*, and the kernel stays generic:
//!
//! * [`EntryViewModule`] — a reactive view over your records. Its `open` /
//!   `on_event_*` / `snapshot` methods are plain inherent methods reached via
//!   static dispatch; there is no `ViewModule` trait.
//! * [`EntryActionModule`] — an `ActionModule` that validates and accepts
//!   generated typed action bytes from this app's native/web shells.
//!
//! Replace `Entry` with your real domain.

use nmp_core::substrate::{ActionModule, ActionRegistrar, AppHost};

pub mod entry_action;
pub mod entry_view;

pub use entry_action::{AddEntryAction, EntryActionModule};
pub use entry_view::{
    EntryDelta, EntryListSpec, EntryListView, EntryRecord, EntryViewModule, EntryViewState,
};

/// Install the reusable NMP substrate into `app`, then wire this app's own
/// modules and selected protocol features on top.
///
/// MUST be called after constructing the native runtime app/builder and BEFORE
/// `start` — every registration must be visible to the kernel when the first
/// event arrives (late wiring is dropped silently per D6).
///
pub fn register(app: &mut (impl AppHost + ActionRegistrar)) {
    // 1. Install the reusable substrate floor: routing, mailbox/profile/contact
    //    caches, parsers, publish resolver, external event forwarding, coverage
    //    gate, and NIP-77 sync hooks. This is correctness plumbing, not product
    //    policy.
    let _substrate_handles = nmp_substrate::install(app, nmp_substrate::SubstrateConfig::default());

    // 2. Install reusable Nostr protocol/runtime features by owner crate. This
    //    keeps every selected layer grep-able for starter apps.
    let _nip50 = nmp_nip50::register(app, nmp_nip50::Config::default())
        .expect("nmp-nip50 registration must not collide");
    let _nip02 = nmp_nip02::register(app, nmp_nip02::Config::default())
        .expect("nmp-nip02 registration must not collide");
    let _replies = nmp_replies::register(app, nmp_replies::Config::default())
        .expect("nmp-replies registration must not collide");
    let _nip25 = nmp_nip25::register(app, nmp_nip25::Config::default())
        .expect("nmp-nip25 registration must not collide");
    let _nip18 = nmp_nip18::register(app, nmp_nip18::Config::default())
        .expect("nmp-nip18 registration must not collide");
    let _nip84 = nmp_nip84::register(app, nmp_nip84::Config::default())
        .expect("nmp-nip84 registration must not collide");
    let _nip29 = nmp_nip29::register(app, nmp_nip29::Config::default())
        .expect("nmp-nip29 registration must not collide");
    let _wot = nmp_wot::register(app, nmp_wot::Config::default())
        .expect("nmp-wot registration must not collide");
    let _nip51 = nmp_nip51::register(
        app,
        nmp_nip51::Config {
            search_fallback_relays: nmp_nip50::SearchFallbackRelays::default(),
        },
    )
    .expect("nmp-nip51 registration must not collide");
    let _nip17 = nmp_nip17::register(app, nmp_nip17::Config::default())
        .expect("nmp-nip17 registration must not collide");
    let _nip22 = nmp_nip22::register(app, nmp_nip22::Config::default())
        .expect("nmp-nip22 registration must not collide");
    let _nip23 = nmp_nip23::register(app, nmp_nip23::Config::default())
        .expect("nmp-nip23 registration must not collide");

    // 3. Register this app's own modules here. ADR-0072: `register_action`
    //    takes the module VALUE, so a stateful module owns dependencies
    //    captured at composition time. The starter action is reached from
    //    generated host builders, through the DispatchEnvelope byte doorway.
    ActionRegistrar::register_action(app, EntryActionModule)
        .expect("starter entry action namespace must be unique");
}

/// The app module identifier. Namespaces below derive from it.
pub const APP_MODULE: &str = "{{name}}.entries";

pub const HOME_TIMELINE_PROJECTION: &str = "{{name}}.timeline.home";
pub const PROFILE_REF_PROJECTION: &str = "refs.profile";
pub const EVENT_REF_PROJECTION: &str = "refs.event";
pub const EVENT_ENVELOPES_PROJECTION: &str = "refs.event.envelopes";
pub const PUBLISH_OUTBOX_PROJECTION: &str = "publish_outbox";
pub const STARTER_PRIMARY_NOTE_KIND: u32 = 1;

/// Projection keys this starter is built around: timeline, profile rows,
/// authoritative event refs, derived embed envelopes, and publish feedback.
pub fn starter_projection_keys() -> [&'static str; 5] {
    [
        HOME_TIMELINE_PROJECTION,
        PROFILE_REF_PROJECTION,
        EVENT_REF_PROJECTION,
        EVENT_ENVELOPES_PROJECTION,
        PUBLISH_OUTBOX_PROJECTION,
    ]
}

/// Kernel built-in projection keys declared through ADR-0070 before `start()`.
///
/// Tier-1 projections such as [`HOME_TIMELINE_PROJECTION`] and
/// [`EVENT_ENVELOPES_PROJECTION`] are runtime/protocol projections that
/// self-gate by registration. Only kernel built-ins are passed to
/// `declare_consumed_projections`.
pub fn starter_builtin_projection_keys() -> [&'static str; 3] {
    [
        PROFILE_REF_PROJECTION,
        EVENT_REF_PROJECTION,
        PUBLISH_OUTBOX_PROJECTION,
    ]
}

/// Typed app-owned feed key for the starter read surface.
///
/// Feed output identity is app-owned; NMP owns the source mechanics and session
/// lifecycle under this key.
pub fn starter_home_feed_key() -> nmp_native_runtime::FeedKey {
    nmp_native_runtime::FeedKey::app(HOME_TIMELINE_PROJECTION)
        .expect("starter home timeline projection is app-owned")
}

/// Typed app-owned feed spec for the starter read surface.
///
/// A real platform shell opens this feed through the runtime and renders the
/// emitted projection. The shell does not derive relay policy, parse protocol
/// wrappers, or keep a domain cache.
pub fn starter_home_feed_spec() -> nmp_native_runtime::FeedSpec {
    nmp_native_runtime::feed::events()
        .primary_kinds([STARTER_PRIMARY_NOTE_KIND])
        .from(nmp_native_runtime::source::active_user().follows())
        .shape(nmp_native_runtime::FeedShape::RootIndexed)
        .order(nmp_native_runtime::FeedOrder::NewestByFeedPosition)
        .window(nmp_native_runtime::FeedWindowPolicy::bounded(80))
        .project(nmp_native_runtime::FeedItemProjection::feed_rows())
}

/// Opaque handle for the starter home timeline session.
///
/// App code keeps this handle and passes it back to close the session. It does
/// not re-derive filters, own source reduction, or select a feed compiler.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct HomeTimelineSession {
    handle: nmp_native_runtime::FeedHandle,
}

impl HomeTimelineSession {
    #[must_use]
    pub fn projection_key(&self) -> &nmp_native_runtime::ProjectionKey {
        &self.handle.projection_key
    }
}

/// Open the starter home timeline as an app-owned typed read session.
///
/// This is the app-level read API. The helper builds the declaration and lets
/// the native runtime apply the reusable NMP compiler internally; callers
/// receive only the session they need to render and later close.
pub fn open_home_timeline_session(
    app: &nmp_native_runtime::NmpApp,
) -> Result<HomeTimelineSession, nmp_native_runtime::FeedSpecOpenError> {
    let handle = app
        .feeds()
        .open_spec(starter_home_feed_key(), starter_home_feed_spec())?;
    Ok(HomeTimelineSession { handle })
}

/// Close a home timeline session opened by [`open_home_timeline_session`].
pub fn close_home_timeline_session(
    app: &nmp_native_runtime::NmpApp,
    session: HomeTimelineSession,
) -> bool {
    app.feeds().close(&session.handle)
}

/// Host-side typed write builders this starter expects platform shells to use.
pub fn starter_action_builder_paths() -> [&'static str; 1] {
    ["GeneratedActionBuilders.addEntry"]
}

/// Module namespaces this app contributes.
pub fn module_namespaces() -> [&'static str; 2] {
    [
        EntryViewModule::NAMESPACE,
        EntryActionModule::NAMESPACE.as_str(),
    ]
}

#[cfg(test)]
mod tests {
    use super::*;
    use nmp_core::substrate::{ActionContext, ActionRejection};

    #[test]
    fn declares_two_distinct_module_namespaces() {
        let mut namespaces = module_namespaces().to_vec();
        namespaces.sort_unstable();
        namespaces.dedup();

        assert_eq!(namespaces.len(), 2);
        assert!(namespaces.iter().any(|ns| ns.ends_with(".view")));
        assert!(namespaces.iter().any(|ns| ns.ends_with(".entries.add")));
    }

    #[test]
    fn action_rejects_empty_label() {
        let mut ctx = ActionContext::default();
        // ADR-0072: `start` takes `&self`; call on the (unit) module value.
        let result = EntryActionModule.start(
            &mut ctx,
            AddEntryAction {
                id: "1".to_string(),
                label: "  ".to_string(),
            },
        );

        assert_eq!(
            result,
            Err(ActionRejection::Invalid("entry label is empty".to_string()))
        );
    }

    #[test]
    fn starter_contract_uses_current_projection_names() {
        let keys = starter_projection_keys();
        let builtins = starter_builtin_projection_keys();

        assert!(keys.contains(&"{{name}}.timeline.home"));
        assert!(keys.contains(&"refs.profile"));
        assert!(keys.contains(&"refs.event"));
        assert!(keys.contains(&"refs.event.envelopes"));
        assert!(builtins.iter().all(|key| keys.contains(key)));
        assert!(!builtins.contains(&"{{name}}.timeline.home"));
        assert!(keys.iter().all(|key| !key.starts_with("resolved_")));
        assert!(keys.iter().all(|key| !key.starts_with("claimed_")));
    }

    #[test]
    fn starter_contract_uses_generated_action_builders() {
        let builders = starter_action_builder_paths();

        assert_eq!(
            builders,
            ["GeneratedActionBuilders.addEntry"]
        );
    }

    #[test]
    fn starter_home_feed_is_typed() {
        let key = starter_home_feed_key();
        let feed = starter_home_feed_spec()
            .into_params(key.clone())
            .expect("starter feed spec is complete");

        assert_eq!(feed.primary_kinds, vec![1]);
        assert_eq!(
            feed.key,
            key
        );
        assert_eq!(
            feed.item_projection,
            nmp_native_runtime::FeedItemProjection::FeedRows
        );
        assert_eq!(
            feed.source,
            nmp_native_runtime::FeedSourceExpr::ActiveUserFollows
        );
    }

    #[test]
    fn starter_home_timeline_session_is_app_owned() {
        let session_type = std::any::type_name::<HomeTimelineSession>();

        assert!(session_type.ends_with("HomeTimelineSession"));
    }
}
