//! Minimal headless shell for `{{display}}`.
//!
//! Models `nmp-defaults`' own `examples/minimal_app.rs`: construct an app via
//! `NmpAppBuilder`, inherit the canonical NMP composition through this crate's
//! [`register`], start the kernel, and tear it down. A real platform shell
//! (SwiftUI / Compose / iced / wasm) drives the same `NmpApp` C-ABI surface.
//!
//! Run it with:
//!
//! ```sh
//! cargo run --example shell -p {{pkg}}
//! ```

use nmp_native_runtime::{NmpAppBuilder, RunConfig};
use nmp_ffi::{nmp_app_free, nmp_app_stop};

fn main() {
    // 1. Start the builder.
    let mut builder = NmpAppBuilder::new();

    // 2. Inherit the canonical NMP composition + this app's modules. The
    //    single `register` call (which forwards to
    //    `nmp_defaults::register_defaults`) is the whole point of ADR-0046.
    {{crate_ident}}::register(&mut builder);

    // 3. Commit the storage choice, declare the consumed projections, decide
    //    the initial relay set, and start the kernel. `.in_memory()` advances
    //    to `StorageSet`; `.consume_all_builtin_projections()` makes the
    //    ADR-0053 decision (this headless shell reads the full built-in set)
    //    and advances to `ProjectionsDeclared`; `.without_initial_relays()`
    //    makes the #1493 relay decision (this app ships no built-in relays —
    //    add your own with `.with_relays([("wss://your.relay", "both")])`) and
    //    advances to `RelaysDeclared`, unlocking `.start()`. For production
    //    replace `.in_memory()` with `.storage_path("/path/to/lmdb")`, prefer
    //    `.declare_consumed_projections([..])` to narrow to the keys your UI
    //    actually reads, and declare your relay set with `.with_relays([..])`.
    //    Omitting ANY decision is a COMPILE ERROR (storage = V-94,
    //    projections = ADR-0053 DEBT 2, relays = #1493).
    let app = builder
        .in_memory()
        .consume_all_builtin_projections()
        .without_initial_relays()
        .start(RunConfig::default());

    println!("{{display}}: NmpAppBuilder → register_defaults → start() complete.");

    // 4. Tear down.
    nmp_app_stop(app);
    nmp_app_free(app);
}
