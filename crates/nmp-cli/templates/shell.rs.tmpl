//! Minimal headless shell for `{{display}}`.
//!
//! Constructs an app via `NmpAppBuilder`, installs this crate's explicit
//! composition root through [`register`], starts the kernel, and tears it down.
//! A real platform shell (SwiftUI / Compose / iced / wasm) drives the same
//! `NmpApp` C-ABI surface.
//!
//! Run it with:
//!
//! ```sh
//! cargo run --example shell -p {{pkg}}
//! ```

use nmp_ffi::{nmp_app_free, nmp_app_stop};
use nmp_native_runtime::{NmpAppBuilder, RunConfig};

fn main() {
    // 1. Start the builder.
    let mut builder = NmpAppBuilder::new();

    // 2. Install the explicit app composition: substrate floor, selected
    //    protocol features, and this app's modules.
    {{crate_ident}}::register(&mut builder);

    // 3. Commit the storage choice, declare the kernel built-in projections,
    //    decide the initial relay set, and start the kernel. `.in_memory()`
    //    advances to `StorageSet`; `.declare_consumed_projections(...)` makes
    //    the ADR-0053 decision for built-ins: profile rows (`refs.profile`),
    //    authoritative event refs (`refs.event`), and publish feedback
    //    (`publish_outbox`). Tier-1 starter projections such as this app's
    //    home timeline and `refs.event.envelopes` self-gate by registration, so
    //    they are named in `starter_projection_keys()` but not declared through
    //    this kernel built-in gate. `.without_initial_relays()` makes
    //    the #1493 relay decision (this app ships no built-in relays — add
    //    your own with
    //    `.with_relays([("wss://your.relay", "both")])`) and advances to
    //    `RelaysDeclared`, unlocking `.start()`. For production replace
    //    `.in_memory()` with `.storage_path("/path/to/lmdb")` and declare your
    //    relay set with `.with_relays([..])`. Omitting ANY decision is a
    //    COMPILE ERROR (storage = V-94, projections = ADR-0053 DEBT 2,
    //    relays = #1493).
    let app = builder
        .in_memory()
        .declare_consumed_projections({{crate_ident}}::starter_builtin_projection_keys())
        .without_initial_relays()
        .start(RunConfig::default());

    let home_timeline_session = {
        // SAFETY: `NmpAppBuilder::start` returns a valid, non-null pointer owned
        // by this shell until `nmp_app_free` below.
        let app_ref = unsafe { &*app };
        {{crate_ident}}::open_home_timeline_session(app_ref).ok()
    };

    println!("{{display}}: NmpAppBuilder → app register → start() complete.");

    // 4. Tear down.
    if let Some(session) = home_timeline_session {
        // SAFETY: same ownership invariant as the open call above.
        let app_ref = unsafe { &*app };
        let _ = {{crate_ident}}::close_home_timeline_session(app_ref, session);
    }
    nmp_app_stop(app);
    nmp_app_free(app);
}
