# Scaffolded by `nmp init {{name}}`.
#
# The `{{pkg}}` crate is the app-owned Rust composition shell. The
# `{{facade_pkg}}` crate is the app-owned UniFFI doorway native shells link.
# See README.md for the release (git-rev pin) vs. local-checkout NMP dependency
# modes.
[workspace]
members = ["crates/{{pkg}}", "crates/{{facade_pkg}}"]
resolver = "2"

[workspace.package]
edition = "2021"
license = "MIT"
version = "0.1.0"
