namespace nmp.nip25;

// Typed FlatBuffers wire for the NIP-25 reaction-aggregate snapshot projection
// (`nmp_nip25::aggregate::ReactionAggregateSnapshot`), schema_id
// "nmp.nip25.reactions".
//
// NIP-25 owns kind:7 reaction semantics: this projection folds the kind:7
// events it is handed by target event id and exposes, per target, the total
// count, the per-emoji breakdown, the distinct reactor pubkeys, and the
// viewer's own reactions (`mine`) — the kind:7 ids the app deletes to retract
// (toggle-off). Scoping the fold to one NIP-29 group is the feeding interest's
// job (a relay-pinned `#h` + `kinds:[5,7]` filter, so relay-delivered kind:5
// deletions decrement the fold); this schema bakes in no group/h-tag concept.
//
// This is the typed sidecar (ADR-0037) carried alongside the generic
// `serde_json::Value` projection registered under the same key by the reaction
// typed read session. The serde shape
// (`ReactionAggregateProjection::snapshot_json`) stays authoritative; this
// buffer mirrors it byte-for-byte in field semantics so a host with an `N25A`
// decoder can read typed accessors instead of JSON reflection.
//
// Raw data only (ADR-0032): the emoji `token` is the verbatim reaction content
// (empty content normalizes to the `"+"` like token) and `reactors` are raw hex
// pubkeys. No `display::` forwarder runs on the encode path.
//
// Regenerate the checked-in Rust bindings only with the workspace FlatBuffers
// pin (25.12.19), enforced by ci/check-flatbuffers-version-pins.sh. The schema
// is self-contained (no `include`), so generate with plain `flatc --rust`:
//
//   flatc --rust -o crates/nmp-nip25/src/wire/generated \
//         crates/nmp-nip25/schema/reaction_aggregate.fbs

// One emoji's tally within a target's aggregate.
table ReactionEmojiCount {
  token:string;    // raw reaction token ("+" for empty/like)
  count:uint64;    // reactions carrying this token for the target
}

// One of the VIEWER'S OWN surviving reactions on a target: the raw emoji token
// plus the raw hex id of the viewer's kind:7 reaction event. This is the
// retraction handle — the app deletes `reaction_event_id` to toggle the
// reaction off (via a host-pinned kind:5 in a NIP-29 group). Raw data only.
table ViewerReaction {
  token:string;              // raw reaction token ("+" for empty/like)
  reaction_event_id:string;  // raw hex id of the viewer's kind:7 to delete
}

// The aggregated reactions for one target event.
table ReactionTargetAggregate {
  target_event_id:string;            // raw hex reacted-to event id
  total:uint64;                      // total reactions across all emoji
  by_emoji:[ReactionEmojiCount];     // count desc, then token asc
  reactors:[string];                 // distinct reactor pubkeys (hex), asc
  mine:[ViewerReaction];             // viewer's own reactions; token asc, id asc
}

// The serialised reaction-aggregate read model. `targets` is ordered by
// `target_event_id` ascending — the encoder ships the snapshot order verbatim.
table ReactionAggregateSnapshot {
  schema_version:uint32 = 2;   // mirrors REACTION_AGGREGATE_SCHEMA_VERSION
  targets:[ReactionTargetAggregate];
}

root_type ReactionAggregateSnapshot;
file_identifier "N25A";
