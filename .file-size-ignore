# .file-size-ignore — gitignore-style globs for files exempt from the
# AGENTS.md 300/500 LOC gate.
#
# Rules:
# - Generated, vendored, lockfile, binary, and benchmark-output artifacts are exempt.
# - Hand-authored source and docs are NOT exempt (that is the point of the gate).
# - Codex review dumps are output artifacts, not authored source — exempt.
# - The smoke-test fixture is intentionally over-limit — exempt so the gate
#   doesn't block normal commits; it is included explicitly by the smoke test step.
#
# Do not add a file here to "hide" a real LOC violation. The correct fix is to
# split the file. Open violations are tracked as brainstorm items.

# Build output
target/**
ios/*/build/**
apps/*/build/**

# Cargo lockfile (generated, not authored)
Cargo.lock

# Codex review output dumps (machine-generated, can be arbitrarily long)
docs/perf/codex-reviews/**

# Agent / harness internal directories
.claude/**

# Smoke-test fixture (intentionally oversized; exercised by --force-include)
crates/nmp-testing/fixtures/file-size-gate/oversized.rs

# Append-only release ledger: grows by design with every release; the
# cohesion rationale of the LOC gate does not apply to a chronological log.
CHANGELOG.md

# Generated proactive-context wiki indexes; individual wiki pages remain checked.
docs/wiki/_index.md
web/registry/docs/wiki/_index.md

# UniFFI-generated Swift bindings (machine-generated, not hand-authored)
ios/*/Sources/*/Core/Generated/*.swift

# FlatBuffers generated bindings (machine-generated, not hand-authored)
crates/**/src/**/generated/*.rs
ios/*/*/Bridge/Generated/*.swift
apps/*/ios/*/Bridge/Generated/*.swift
apps/chirp/android/app/src/main/java/org/nmp/android/ActionBuilders.kt
apps/chirp/android/app/src/main/java/nmp/**
apps/*/android/app/src/main/kotlin/nmp/transport/**
web/packages/runtime-web/src/actionBuilders.generated.ts
web/nmp-gallery/src/nmp/generated/**
# Generated typed action-builders for the web runtime (emitted by
# `nmp-codegen gen action-builders --platform ts`; the Swift/Kotlin siblings
# above are exempt for the same reason). Drift is enforced by the codegen
# `--check` gate, not the LOC gate.
web/packages/runtime-web/src/actionBuilders.generated.ts

# UniFFI-generated Kotlin bindings (machine-generated by uniffi-bindgen, not hand-authored)
apps/chirp/android/app/src/main/java/org/nmp/android/uniffi/**

# nmp-uniffi generated Swift/Kotlin bindings (machine-generated by uniffi-bindgen; drift
# enforced by ci/check-uniffi-bindings-drift.sh, not the LOC gate).
crates/nmp-uniffi/generated/**

# Web registry vendor mirror (copied output, source lives under crates/nmp-cli/registry/)
web/registry/src/vendor/**

# Vendored SQLite-WASM artifact (#1007): the public-domain sqlite.org engine
# glue `sqlite3.mjs` is a ~14k-line generated `.mjs` (a checked extension), and
# the hand-authored shim glue sits beside it so its `import './sqlite3.mjs'`
# resolves locally. Integrity is enforced by SHA-256 (ci/verify-sqlite-wasm-artifact.sh),
# not the LOC gate. Provenance: crates/nmp-sqlite-wasm/vendor/PROVENANCE.md (NOT exempt).
crates/nmp-sqlite-wasm/vendor/sqlite-wasm/**
