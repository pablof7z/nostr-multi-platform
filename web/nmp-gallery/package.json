{
  "name": "@nmpis/gallery-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "echo 'wasm build deferred to #2038 (nmp-browser-runtime composition root)' && exit 1",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nmpis/components-web": "*",
    "@nmpis/runtime-web": "*",
    "flatbuffers": "^25.9.23",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7"
  }
}
