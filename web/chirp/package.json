{
  "name": "@nmp/chirp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "CC_wasm32_unknown_unknown=clang wasm-pack build --target web ../../apps/chirp/nmp-app-chirp-web --out-dir ../../../web/chirp/public/nmp-wasm",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nmp/components-web": "*",
    "@nmp/runtime-web": "*",
    "flatbuffers": "^25.9.23",
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/ws": "^8.5.14",
    "nostr-tools": "^2.23.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7",
    "ws": "^8.18.2"
  }
}
